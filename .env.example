# SkillVerse Environment Configuration
# Copy this file to .env and update with your values

# ─── Flask Configuration ─────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ─── Database Configuration ──────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost/skillverse_pg

# ─── Admin Account (Created on first run) ────────────────────
ADMIN_EMAIL=admin@skillverse.com
ADMIN_PASSWORD=admin123

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email Configuration (Gmail SMTP) ────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=SkillVerse <your-email@gmail.com>
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# ─── AskVera AI Chatbot ──────────────────────────────────────
ENABLE_ASKVERA=False
GROQ_API_KEY=your-groq-api-key
